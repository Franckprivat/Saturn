# ─────────────────────────────────────────────────────────────
#  Saturn frontend-web — mode LOCAL (exemple, optionnel)
#  Copie en frontend-web/.env.local pour `npm run dev` hors Docker.
#  Sans ce fichier, le code retombe déjà sur http://localhost:3001.
#
#  En Docker, ces valeurs sont ignorées : docker-compose définit les
#  variables NEXT_PUBLIC_* du conteneur, qui priment sur .env.local.
# ─────────────────────────────────────────────────────────────

# Backend NestJS en direct (axios, uploads, Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:3001
# better-auth : origine du backend, le client ajoute /api/auth
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
