# Frontend Next.js — image multi-étapes
#   target "dev"  : next dev avec hot reload (docker-compose.dev.yml)
#   target "prod" : next build + serveur standalone (défaut)

FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
# npm ci garantit des builds reproductibles (lockfile strict)
RUN npm ci

# ── Développement ────────────────────────────────────────────
FROM deps AS dev
COPY . .
USER node
EXPOSE 3000
CMD ["npm", "run", "dev"]

# ── Build de production ──────────────────────────────────────
FROM deps AS build
# Les NEXT_PUBLIC_* sont figées dans le bundle au moment du build
ARG NEXT_PUBLIC_API_URL=http://localhost/api
ARG NEXT_PUBLIC_AUTH_URL=http://localhost
ARG NEXT_PUBLIC_SOCKET_URL=http://localhost
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL \
    NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
COPY . .
RUN npm run build

# ── Exécution (serveur standalone, sans les sources ni devDependencies) ──
FROM node:22-alpine AS prod
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
