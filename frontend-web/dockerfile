# Frontend Next.js
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
# npm ci garantit des builds reproductibles (lockfile strict)
RUN npm ci

# Le code source est monté via volume en dev — COPY sert de fallback
COPY . .

# Non-root pour la sécurité
USER node
EXPOSE 3000

CMD ["npm", "run", "dev"]
