# ─────────────────────────────────────────────────────────────
#  Saturn — Variables d'environnement, mode DOCKER (exemple)
#  Copie ce fichier en .env (à la racine) et remplis les valeurs.
#  Utilisé par `docker compose up` (services db, backend, frontend-web).
#
#  Pour le mode LOCAL (`npm run dev` hors Docker), utilise plutôt :
#    backend/.env.example          → backend/.env
#    frontend-web/.env.local.example → frontend-web/.env.local (optionnel)
#  Les deux .env doivent avoir les mêmes POSTGRES_* / secret ; seuls les
#  hôtes, ports et URLs changent (db:5432 ici, localhost:5433 en local).
#
#  Ne commite JAMAIS le fichier .env avec de vraies credentials.
# ─────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────
POSTGRES_USER=ton_user_pg
POSTGRES_PASSWORD=ton_mot_de_passe_pg
POSTGRES_DB=saturn-db
# Hôte "db" = nom du service Postgres dans le réseau Docker (port interne 5432)
DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@db:5432/saturn-db?schema=public
# Utilisé par better-auth (même base, sans ?schema=public)
BETTER_AUTH_DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@db:5432/saturn-db

# ── URL publique ─────────────────────────────────────────────
# Adresse vue par le navigateur (Nginx). Sert au build du frontend et à better-auth.
# En production : https://ton-domaine (voir nginx/nginx.https.conf.example)
PUBLIC_URL=http://localhost

# ── Backend ──────────────────────────────────────────────────
# PORT est fixé à 3000 par docker-compose (Nginx → backend:3000), inutile ici.
# Origine publique vue par le navigateur = Nginx sur http://localhost
# (docker-compose force aussi cette valeur pour le service backend)
BETTER_AUTH_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# Secret de session — génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
BETTER_AUTH_SECRET=REMPLACE_PAR_UN_SECRET_64_CHARS_ALEATOIRE

# ── Compte démo (optionnel) ──────────────────────────────────
# true active le compte de démonstration (voir la page d'accueil)
DEMO_ACCOUNT_ENABLED=false
# DEMO_ACCOUNT_EMAIL=demo@example.com
# DEMO_ACCOUNT_PASSWORD=saturn-demo

# ── Proxy (optionnel) ────────────────────────────────────────
# Valeur Express « trust proxy ». Par défaut : loopback, linklocal, uniquelocal
# (Nginx dans le réseau Docker). Le rate limit d'auth lit X-Real-IP posé par
# Nginx : en production, n'expose pas le port 3001 du backend publiquement.
# TRUST_PROXY=1

# ── IA (optionnel) ───────────────────────────────────────────
# Récupère ta clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Appels audio/vidéo : relais TURN (optionnel, recommandé en production) ──
# Sans TURN, les appels échouent derrière certains NAT (4G, réseaux d'entreprise).
# Serveur coturn avec use-auth-secret : identifiants temporaires générés par le backend.
# TURN_URLS=turn:turn.ton-domaine.com:3478,turns:turn.ton-domaine.com:5349
# TURN_SECRET=meme_valeur_que_static-auth-secret_de_coturn
# Ou identifiants fixes : TURN_USERNAME=... / TURN_CREDENTIAL=...

# ── Email / Reset de mot de passe (optionnel) ────────────────
# Sans SMTP_USER, aucun e-mail ne part (reset et vérification désactivés).
# true : la connexion exige une adresse vérifiée (seulement si SMTP est configuré)
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
# Génère un "App Password" Gmail : myaccount.google.com/apppasswords
SMTP_PASS=

# ── Stockage fichiers — Cloudflare R2 (optionnel) ────────────
# Sans R2 : les fichiers sont stockés sur disque (perdus au redeploy)
# Crée un bucket sur https://dash.cloudflare.com > R2
# R2_ACCOUNT_ID=ton_account_id_cloudflare
# R2_ACCESS_KEY_ID=ton_r2_access_key
# R2_SECRET_ACCESS_KEY=ton_r2_secret_key
# R2_BUCKET_NAME=saturn-uploads
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev  (ou ton domaine custom)

# ── Production uniquement ────────────────────────────────────
# BACKEND_URL=https://api.ton-domaine.com
