# ─────────────────────────────────────────────────────────────
#  Saturn — Variables d'environnement (exemple)
#  Copie ce fichier en .env et remplis les valeurs.
#  Ne commite JAMAIS le fichier .env avec de vraies credentials.
# ─────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────
POSTGRES_USER=ton_user_pg
POSTGRES_PASSWORD=ton_mot_de_passe_pg
POSTGRES_DB=saturn-db
DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@db:5432/saturn-db?schema=public
# Utilisé par better-auth (même base, sans ?schema=public)
BETTER_AUTH_DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@db:5432/saturn-db

# ── Backend ──────────────────────────────────────────────────
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Secret de session — génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
BETTER_AUTH_SECRET=REMPLACE_PAR_UN_SECRET_64_CHARS_ALEATOIRE

# ── IA (optionnel) ───────────────────────────────────────────
# Récupère ta clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Email / Reset de mot de passe (optionnel) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
# Génère un "App Password" Gmail : myaccount.google.com/apppasswords
SMTP_PASS=

# ── Stockage fichiers — Cloudflare R2 (optionnel) ────────────
# Sans R2 : les fichiers sont stockés sur disque (perdus au redeploy)
# Crée un bucket sur https://dash.cloudflare.com > R2
# R2_ACCOUNT_ID=ton_account_id_cloudflare
# R2_ACCESS_KEY_ID=ton_r2_access_key
# R2_SECRET_ACCESS_KEY=ton_r2_secret_key
# R2_BUCKET_NAME=saturn-uploads
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev  (ou ton domaine custom)

# ── Production uniquement ────────────────────────────────────
# BACKEND_URL=https://api.ton-domaine.com
