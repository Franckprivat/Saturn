generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  firstName     String?
  lastName      String?
  nickname      String?
  bio           String?
  socialLinks   Json?
  avatarColor   String?
  chatWallpaper String?

  sessions      Session[]
  accounts      Account[]

  messages               Message[]
  reactions              MessageReaction[]
  readReceipts           ReadReceipt[]
  deliveryReceipts       DeliveryReceipt[]
  conversations          ConversationParticipant[]
  communityMemberships   CommunityMember[]
  friendRequestsSent     Friendship[] @relation("FriendshipRequester")
  friendRequestsReceived Friendship[] @relation("FriendshipAddressee")
  callLogs               CallLog[]
  sentCommunityInvites     CommunityInvite[]      @relation("SentCommunityInvites")
  receivedCommunityInvites CommunityInvite[]      @relation("ReceivedCommunityInvites")
  createdInviteLinks       CommunityInviteLink[]  @relation("CreatedInviteLinks")
  communityJoins           CommunityJoinLog[]     @relation("CommunityJoins")
  communityJoinRequests    CommunityJoinRequest[] @relation("CommunityJoinRequests")
  communityBans            CommunityBan[]         @relation("CommunityBans")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Conversation {
  id              String                    @id @default(uuid())
  createdAt       DateTime                  @default(now())
  type            ConversationType          @default(DM)
  name            String?
  description     String?
  image           String?
  creatorId       String?
  inviteToken     String?                   @unique
  communityId     String?
  community       Community?                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants    ConversationParticipant[]
  messages        Message[]
  pinnedMessages  PinnedMessage[]
  channel         Channel?
}

model ConversationParticipant {
  id             String            @id @default(uuid())
  user           User              @relation(fields: [userId], references: [id])
  userId         String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  conversationId String
  role           GroupRole         @default(MEMBER)
}

model Message {
  id             String            @id @default(uuid())
  content        String            @default("")
  sender         User              @relation(fields: [senderId], references: [id])
  senderId       String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  conversationId String
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  fileUrl        String?
  fileName       String?
  fileType       String?
  whisperTo      String[]
  isWhisper      Boolean           @default(false)
  type           MessageType       @default(MESSAGE)
  metadata       Json?
  deletedAt      DateTime?
  replyToId      String?
  replyTo        Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReply")
  reactions      MessageReaction[]
  readBy         ReadReceipt[]
  deliveredTo    DeliveryReceipt[]
  pinnedIn       PinnedMessage[]
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

enum MessageType {
  MESSAGE
  SYSTEM
  INVITE
}

model Friendship {
  id          String           @id @default(uuid())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id])
  requesterId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

/// Reçu « distribué » : le message est arrivé sur l'appareil du destinataire
/// (statut intermédiaire entre envoyé et lu, façon WhatsApp).
model DeliveryReceipt {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime @default(now())

  @@unique([messageId, userId])
}

model PinnedMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy       String
  pinnedAt       DateTime     @default(now())

  @@unique([conversationId, messageId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ConversationType {
  DM
  GROUP
  CHANNEL
}

/* ─── Communautés (façon Discord) ─────────────────────────────────────────── */

model Community {
  id            String            @id @default(uuid())
  name          String
  description   String?
  image         String?
  ownerId       String
  inviteToken   String?           @unique
  /// OPEN : un lien valide suffit. APPROVAL : le lien crée une demande d'adhésion.
  joinPolicy    JoinPolicy        @default(OPEN)
  /// Rôle minimal par action ({ invite: "MEMBER", ban: "ADMIN", … }) — défauts en service.
  permissions   Json?
  createdAt     DateTime          @default(now())
  members       CommunityMember[]
  categories    ChannelCategory[]
  channels      Channel[]
  conversations Conversation[]
  invites       CommunityInvite[]
  inviteLinks   CommunityInviteLink[]
  joinRequests  CommunityJoinRequest[]
  joinLogs      CommunityJoinLog[]
  bans          CommunityBan[]
  auditLogs     CommunityAuditLog[]
}

enum JoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Invitation directe adressée à un utilisateur précis (expire automatiquement).
model CommunityInvite {
  id          String                @id @default(uuid())
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  inviter     User                  @relation("SentCommunityInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId   String
  invitee     User                  @relation("ReceivedCommunityInvites", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId   String
  message     String?
  status      CommunityInviteStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([communityId, status])
  @@index([inviteeId, status])
}

/// Lien d'invitation configurable (plusieurs par communauté).
model CommunityInviteLink {
  id          String             @id @default(uuid())
  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  creator     User               @relation("CreatedInviteLinks", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  token       String             @unique
  label       String?
  maxUses     Int?
  uses        Int                @default(0)
  expiresAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime           @default(now())
  joins       CommunityJoinLog[]

  @@index([communityId])
}

/// Parrainage : origine de chaque membre (lien utilisé ou inviteur direct).
model CommunityJoinLog {
  id           String               @id @default(uuid())
  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId  String
  user         User                 @relation("CommunityJoins", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  viaLink      CommunityInviteLink? @relation(fields: [viaLinkId], references: [id], onDelete: SetNull)
  viaLinkId    String?
  viaInviterId String?
  joinedAt     DateTime             @default(now())

  @@index([communityId])
}

/// Demande d'adhésion (communautés en mode APPROVAL).
model CommunityJoinRequest {
  id            String            @id @default(uuid())
  community     Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId   String
  user          User              @relation("CommunityJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  message       String?
  status        JoinRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  respondedAt   DateTime?
  respondedById String?

  @@index([communityId, status])
}

model CommunityBan {
  id          String    @id @default(uuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  user        User      @relation("CommunityBans", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  bannedById  String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

/// Journal d'audit des actions liées aux invitations et à la modération.
model CommunityAuditLog {
  id           String    @id @default(uuid())
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId  String
  actorId      String
  action       String
  targetUserId String?
  linkId       String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([communityId, createdAt])
}

model CommunityMember {
  id          String        @id @default(uuid())
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([communityId, userId])
}

model ChannelCategory {
  id          String    @id @default(uuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  name        String
  position    Int       @default(0)
  channels    Channel[]
}

model Channel {
  id             String           @id @default(uuid())
  community      Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId    String
  category       ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  name           String
  type           ChannelType      @default(TEXT)
  position       Int              @default(0)
  conversationId String?          @unique
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
}

model CallLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  direction      String
  status         String
  duration       Int?
  withName       String
  withImage      String?
  withNickname   String?
  conversationId String?
  createdAt      DateTime @default(now())

  @@map("call_log")
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
}

enum GroupRole {
  ADMIN
  MEMBER
}
