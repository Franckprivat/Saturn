# Backend NestJS
FROM node:22-alpine

WORKDIR /usr/src/app

COPY package*.json ./
# npm ci garantit des builds reproductibles (lockfile strict)
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# Mode production (rate limit better-auth, cookies, logs Nest)
ENV NODE_ENV=production

# Dossier des uploads écrit par l'utilisateur node : un volume Docker neuf
# reprend ces droits (sinon EACCES à chaque upload, le volume étant à root)
RUN mkdir -p uploads && chown node:node uploads

# Non-root pour la sécurité
USER node
EXPOSE 3000

# Les migrations sont appliquées avant le démarrage
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main.js"]
