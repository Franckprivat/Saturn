# ─────────────────────────────────────────────────────────────
#  Saturn backend — Variables d'environnement, mode LOCAL (exemple)
#  Copie ce fichier en backend/.env pour lancer `npm run dev` hors Docker.
#  Chargé par `import 'dotenv/config'` (src/main.ts) et prisma.config.ts.
#
#  La base tourne dans Docker : `docker compose up -d db`.
#  docker-compose l'expose sur l'hôte en 127.0.0.1:5433 (et non 5432,
#  pour ne pas entrer en conflit avec un Postgres installé localement).
#  Utilise les mêmes POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB que
#  le .env racine : ce sont eux qui ont initialisé la base.
#
#  Ne commite JAMAIS le fichier .env avec de vraies credentials.
# ─────────────────────────────────────────────────────────────

# ── Base de données (Postgres Docker exposé sur localhost:5433) ──
DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@localhost:5433/saturn-db?schema=public
BETTER_AUTH_DATABASE_URL=postgresql://ton_user_pg:ton_mot_de_passe_pg@localhost:5433/saturn-db

# ── Backend ──────────────────────────────────────────────────
# Le front (localhost:3000) appelle le backend directement sur :3001
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Même secret que le .env racine si tu veux garder tes sessions entre les deux modes
BETTER_AUTH_SECRET=REMPLACE_PAR_UN_SECRET_64_CHARS_ALEATOIRE

# ── Compte démo (optionnel) ──────────────────────────────────
# true active le compte de démonstration (voir la page d'accueil)
DEMO_ACCOUNT_ENABLED=false
# DEMO_ACCOUNT_EMAIL=demo@example.com
# DEMO_ACCOUNT_PASSWORD=saturn-demo

# ── Optionnel (voir .env.example à la racine) ────────────────
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
